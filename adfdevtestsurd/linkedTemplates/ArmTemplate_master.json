{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevtestsurd"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LS_Parent_SQLServer_DW_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Parent_SQLServer_DW'"
		},
		"LS_SQL_Migration_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_Migration'"
		},
		"LS_ADLS_SQL_Parquet_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_SQL_Parquet'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccadlsdevtest.dfs.core.windows.net/"
		},
		"LS_Parent_SQLServer_DW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SURDEEP\\SQLEXPRESS"
		},
		"LS_Parent_SQLServer_DW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RetailDW_Dev"
		},
		"LS_Parent_SQLServer_DW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "surdeepsql"
		},
		"LS_SQL_Migration_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SURDEEP\\SQLEXPRESS"
		},
		"LS_SQL_Migration_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "devmigration"
		},
		"LS_SQL_Migration_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "surdeepsql"
		},
		"LS_ADLS_SQL_Parquet_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccadlsdevtest.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevtestsurd_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"LS_Parent_SQLServer_DW_password": {
						"value": "[parameters('LS_Parent_SQLServer_DW_password')]"
					},
					"LS_SQL_Migration_password": {
						"value": "[parameters('LS_SQL_Migration_password')]"
					},
					"LS_ADLS_SQL_Parquet_accountKey": {
						"value": "[parameters('LS_ADLS_SQL_Parquet_accountKey')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_Parent_SQLServer_DW_properties_typeProperties_server": {
						"value": "[parameters('LS_Parent_SQLServer_DW_properties_typeProperties_server')]"
					},
					"LS_Parent_SQLServer_DW_properties_typeProperties_database": {
						"value": "[parameters('LS_Parent_SQLServer_DW_properties_typeProperties_database')]"
					},
					"LS_Parent_SQLServer_DW_properties_typeProperties_userName": {
						"value": "[parameters('LS_Parent_SQLServer_DW_properties_typeProperties_userName')]"
					},
					"LS_SQL_Migration_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_Migration_properties_typeProperties_server')]"
					},
					"LS_SQL_Migration_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_Migration_properties_typeProperties_database')]"
					},
					"LS_SQL_Migration_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_Migration_properties_typeProperties_userName')]"
					},
					"LS_ADLS_SQL_Parquet_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_SQL_Parquet_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}